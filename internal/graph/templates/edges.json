{
  "index_patterns": ["engram-graph-edges*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "id": { "type": "keyword" },
        "tenant_id": { "type": "keyword" },
        "team_id": { "type": "keyword" },
        "scope": { "type": "keyword" },
        "owner_agent_id": { "type": "keyword" },
        "from_entity_id": { "type": "keyword" },
        "to_entity_id": { "type": "keyword" },
        "predicate": { "type": "keyword" },
        "statement": { "type": "text" },
        "source_ids": { "type": "keyword" },
        "valid_at": { "type": "date" },
        "invalid_at": { "type": "date" },
        "created_at": { "type": "date" },
        "expired_at": { "type": "date" }
      }
    }
  }
}
