{
  "index_patterns": ["engram-acl-edges*"],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "type": { "type": "keyword" },
        "tenant_id": { "type": "keyword" },
        "user_id": { "type": "keyword" },
        "agent_id": { "type": "keyword" },
        "team_id": { "type": "keyword" },
        "created_at": { "type": "date" }
      }
    }
  }
}
