{
  "corpus": [
    {
      "id": "doc-pay-timeout",
      "text": "Service payments-api has a hard request timeout of 2500ms configured in PAY-cfg-114."
    },
    {
      "id": "doc-inc-4312",
      "text": "Incident INC-4312 was caused by a leaked connection pool in orders-svc after the v2.14 deploy."
    },
    {
      "id": "doc-own-search",
      "text": "The search-platform team owns the opensearch-gateway service; escalation goes to @maya.chen."
    },
    {
      "id": "doc-dep-freeze",
      "text": "Deploy freezes start every quarter on the last Thursday and are tracked in REL-freeze-Q."
    },
    {
      "id": "doc-tok-rotate",
      "text": "API tokens for vault-broker rotate every 12 hours; manual rotation uses runbook RB-77."
    },
    {
      "id": "doc-db-primary",
      "text": "The billing Postgres primary is db-bill-01 in us-east-2a; failover target is db-bill-02."
    },
    {
      "id": "doc-rate-limit",
      "text": "Public API rate limit is 600 requests per minute per key, enforced by edge-limiter."
    },
    {
      "id": "doc-inc-4388",
      "text": "Incident INC-4388 traced to a bad glibc upgrade on the build fleet; fixed by pinning image bld-2024.09."
    },
    {
      "id": "doc-kafka-lag",
      "text": "Consumer lag alerts for the events pipeline fire at 30k messages via alert EVT-lag-30k."
    },
    {
      "id": "doc-gpu-quota",
      "text": "Each ML team gets 64 A100-hours per day; overage requests go through ML-QUOTA board."
    },
    {
      "id": "doc-cdn-purge",
      "text": "CDN cache purges propagate globally within 90 seconds using the purge-fanout job."
    },
    {
      "id": "doc-oncall-rot",
      "text": "Primary on-call rotates weekly on Mondays 10:00 UTC; the schedule lives in PagerPlane."
    },
    {
      "id": "doc-tf-state",
      "text": "Terraform state for core-infra is stored in bucket tf-core-state-prod with DynamoDB locking."
    },
    {
      "id": "doc-sso-idp",
      "text": "Workforce SSO runs through Okta tenant meridian-corp; break-glass accounts are in BG-vault."
    },
    {
      "id": "doc-canary-pct",
      "text": "Canary deploys route 5% of traffic for 30 minutes before full rollout, gated by canary-judge."
    },
    {
      "id": "doc-log-retent",
      "text": "Production logs retain 30 days hot and 13 months cold in the logging-lake archive."
    },
    {
      "id": "doc-mtls-cert",
      "text": "Internal mTLS certificates expire after 90 days and auto-renew at 60 via cert-minter."
    },
    {
      "id": "doc-perf-slo",
      "text": "checkout-web has a p95 latency SLO of 350ms measured at the edge, dashboard PERF-co-web."
    },
    {
      "id": "doc-repo-mono",
      "text": "All Go services live in the monorepo meridian/go-services; ownership is per-directory CODEOWNERS."
    },
    {
      "id": "doc-sec-scan",
      "text": "Container images are blocked from deploy on critical CVEs by the sentinel-scan admission gate."
    },
    {
      "id": "doc-flag-svc",
      "text": "Feature flags are served by flagd-edge with a 10s propagation SLA; kill switches use KS- prefixes."
    },
    {
      "id": "doc-backup-rpo",
      "text": "Billing data RPO is 5 minutes via WAL shipping; restore drills run monthly under DR-bill."
    },
    {
      "id": "doc-inc-4501",
      "text": "Incident INC-4501: expired SAML metadata broke vendor logins; renewal automated in job saml-refresh."
    },
    {
      "id": "doc-queue-dlq",
      "text": "Failed webhook deliveries retry 8 times with exponential backoff then land in hooks-dlq."
    },
    {
      "id": "doc-cost-tag",
      "text": "Every cloud resource must carry cost-center and service tags; untagged spend pages FinOps weekly."
    },
    {
      "id": "doc-api-vers",
      "text": "Public API versions are date-pinned (e.g. 2025-06-01) and supported for 24 months after sunset notice."
    },
    {
      "id": "doc-chaos-day",
      "text": "Chaos experiments run in prod every second Wednesday, coordinated through the storm-runner tool."
    },
    {
      "id": "doc-data-resid",
      "text": "EU customer data stays in eu-central-1 under policy DATA-RES-EU; cross-region copies are blocked."
    },
    {
      "id": "doc-build-cache",
      "text": "CI build cache hits average 82% using the bazel-remote cluster; misses page nobody."
    },
    {
      "id": "doc-pii-mask",
      "text": "PII is masked at ingestion by the scrub-gate library; raw values never reach the lake."
    }
