{
  "name": "engram",
  "version": "0.2.0",
  "description": "Engram agent memory: hybrid search over episodic, semantic and graph memory plus knowledge collections, as memory_* and knowledge_* MCP tools. Needs engramd at ENGRAM_ADDR and ENGRAM_TOKEN.",
  "author": {
    "name": "rtd"
  },
  "license": "MIT",
  "keywords": [
    "memory",
    "mcp",
    "opensearch",
    "hybrid-retrieval",
    "knowledge-graph",
    "bi-temporal"
  ],
  "mcpServers": {
    "engram": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/engram-mcp-launch.sh",
      "args": [
        "-addr",
        "${ENGRAM_ADDR}"
      ],
      "env": {
        "ENGRAM_TOKEN": "${ENGRAM_TOKEN}",
        "ENGRAM_ADDR": "${ENGRAM_ADDR}"
      }
    }
  }
}
